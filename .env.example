# ──────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in secrets
# ──────────────────────────────────────────────────────────────────

# Port exposed on the host for Caddy
HOST_PORT=8080

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=irid_example

# Host port on which PostgreSQL is published. Host-side tooling such as
# data-raw/generate_geo.R connects through this port. The container itself
# always listens on 5432 internally, so changing this only moves the host
# mapping (e.g. when 5432 is already in use on the host).
POSTGRES_HOST_PORT=5432

# Replica count for irid
IRID_REPLICAS=1

# Health check tuning
HEALTHCHECK_INTERVAL=15s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_START_PERIOD=30s
HEALTHCHECK_RETRIES=3

# UID/GID for container user (match host to avoid volume permission issues)
UID=1000
GID=1000
